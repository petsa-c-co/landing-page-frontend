# URL base de la API.
#
# En desarrollo se deja como ruta relativa: Vite proxea /api hacia el backend
# (ver server.proxy en vite.config.ts), así el navegador ve todo en el mismo
# origen y el sitio se puede abrir desde otro dispositivo de la red sin
# configurar CORS ni hardcodear la IP de la máquina.
#
# En producción, apuntá al dominio real de la API incluyendo el prefijo /api
# (p. ej. https://api.petrogassa.com/api) o dejalo relativo si nginx sirve el
# frontend y proxea /api al backend.
VITE_API_URL=/api
